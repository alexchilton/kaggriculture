"""A weed on a tile the tape is about to build on must be dug, and the build re-issued.

`weedSpawnChance` is 0.005 on the ladder, not 0. A weed can therefore appear on a tile that was
EMPTY when the tape was recorded, and `BUILD_PASTURE`, `BUILD_COOP` and `PLANT` all require
`tile is None` (`reference/kaggriculture.py:493`). The tape has no DIG for it, because on the board
it was recorded on that tile was clean. So the op fails silently and the tile is deleted from the
plan for the rest of the season.

Measured on ladder game 97486506 (seat 0, seed 1295880723, LOST 73,699 to 109,513):

    d2  h0   t48    WEED spawns on (4,2), a tile that was EMPTY the turn before
    d4  h17  t113   BUILD_PASTURE on (4,2)  -> still WEED, build FAILED
    d5  h8   t128   PLACE COW    on (4,2)  -> no pasture, place FAILED
    end             12 pastures, 11 animals -- one cow paid for and never landed

and the cost compounds: weeds go 1 -> 2 -> 4 -> 4 by d15, and the tape clears none of them.

**The turns to do this in are already free.** The unit that fails the build then sits on the tile
doing nothing until the day ends:

    t113 d4 h17 at (4,2) on WEED -> BUILD_PASTURE     (fails)
    t114 d4 h18 at (4,2) on WEED -> PASS
    t115 d4 h19 at (4,2) on WEED -> PASS
    t116 .. t119                 -> PASS

So DIG on the turn the build would have failed, and re-issue the build on a PASS turn the tape was
throwing away. No tape op is ever displaced, and this can only fire on a tile the tape itself acts
on -- it never goes hunting for weeds on ground the plan does not use.

Sized across the three downloaded ladder games, ops blocked by a weed:

    97486506 seat 0   5   BUILD_PASTURE 1, PLANT 4   tiles (2,2) (4,2)
    97472874 seat 1   0
    97468644 seat 0   1   PLANT 1                    tile (6,1)
    97468644 seat 1   0

Rare, and one seat of four. That seat is the one that lost.
"""

import pathlib
import sys

REPO = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO))

from kagg.search import schedule_agent as SA                       # noqa: E402

WEED = {"kind": "WEED"}


def _board(weed_at=()):
    """A 10x10 board of EMPTY, with WEED at the given (x, y)."""
    tiles = [[None] * 10 for _ in range(10)]
    for x, y in weed_at:
        tiles[y][x] = dict(WEED)
    return tiles


def test_a_build_onto_a_weed_becomes_a_dig():
    """RED: the tape's BUILD_PASTURE is sent verbatim onto a WEED, where it silently no-ops."""
    acts = [["PASS"], ["PASS"], ["PASS"], ["BUILD_PASTURE"]]
    positions = [(0, 0), (1, 1), (2, 2), (4, 2)]
    deferred = {}

    out = SA.clear_a_weed_the_tape_needs_gone(acts, positions, _board([(4, 2)]), deferred)

    assert out[3][0] == "DIG", (
        "unit 3 stands on a WEED and the tape says BUILD_PASTURE, which requires tile is None; "
        "it must dig instead, got %r" % (out[3],))
    assert deferred.get(3) == ((4, 2), ["BUILD_PASTURE"]), (
        "the displaced build must be remembered WITH its tile, or a free turn could re-issue it "
        "after the unit has walked somewhere else, got %r" % (deferred,))


def test_the_deferred_build_is_re_issued_on_a_pass_turn():
    """RED: the six PASS turns after the failed build are thrown away."""
    deferred = {3: ((4, 2), ["BUILD_PASTURE"])}
    acts = [["PASS"], ["PASS"], ["PASS"], ["PASS"]]
    positions = [(0, 0), (1, 1), (2, 2), (4, 2)]

    out = SA.clear_a_weed_the_tape_needs_gone(acts, positions, _board(), deferred)

    assert out[3] == ["BUILD_PASTURE"], (
        "the tape wastes this turn on PASS and the tile is clear now, so the remembered build "
        "belongs here, got %r" % (out[3],))
    assert 3 not in deferred, "a re-issued op must not be re-issued again: %r" % (deferred,)


def test_a_real_tape_op_is_never_displaced():
    """The deferred build waits for a PASS. It must never overwrite work the tape asked for."""
    deferred = {3: ((4, 2), ["BUILD_PASTURE"])}
    acts = [["PASS"], ["PASS"], ["PASS"], ["WATER"]]
    positions = [(0, 0), (1, 1), (2, 2), (4, 2)]

    out = SA.clear_a_weed_the_tape_needs_gone(acts, positions, _board(), deferred)

    assert out[3] == ["WATER"], "the tape's own op must survive, got %r" % (out[3],)
    assert deferred.get(3) == ((4, 2), ["BUILD_PASTURE"]), "the build should still be pending"


def test_a_weed_on_ground_the_tape_does_not_use_is_left_alone():
    """Alex's constraint: only ever clear a weed that blocks an op the tape actually issues."""
    acts = [["PASS"], ["PASS"], ["PASS"], ["NORTH"]]
    positions = [(0, 0), (1, 1), (2, 2), (4, 2)]
    deferred = {}

    out = SA.clear_a_weed_the_tape_needs_gone(acts, positions, _board([(4, 2), (9, 9)]), deferred)

    assert out[3] == ["NORTH"], "a move across a weed is not a reason to dig, got %r" % (out[3],)
    assert not deferred, "nothing was blocked, so nothing should be pending: %r" % (deferred,)


def test_a_plant_onto_a_weed_becomes_a_dig():
    """PLANT carries the same `tile is None` guard, and 4 of the 5 blocked ops measured were PLANT."""
    acts = [["PLANT", "WHEAT"]]
    positions = [(2, 2)]
    deferred = {}

    out = SA.clear_a_weed_the_tape_needs_gone(acts, positions, _board([(2, 2)]), deferred)

    assert out[0][0] == "DIG", "PLANT onto a WEED must dig first, got %r" % (out[0],)
    assert deferred.get(0) == ((2, 2), ["PLANT", "WHEAT"]), (
        "the crop must be carried on the deferred op, not just the op name: %r" % (deferred,))


def test_a_deferred_build_is_dropped_if_the_unit_walks_away():
    """It is tile-specific. A pasture re-issued on the wrong tile is worse than no pasture."""
    deferred = {3: ((4, 2), ["BUILD_PASTURE"])}
    acts = [["PASS"], ["PASS"], ["PASS"], ["PASS"]]
    positions = [(0, 0), (1, 1), (2, 2), (7, 7)]

    out = SA.clear_a_weed_the_tape_needs_gone(acts, positions, _board(), deferred)

    assert out[3] == ["PASS"], "the unit is not on the tile any more, got %r" % (out[3],)
    assert 3 not in deferred, "and the stale build must be forgotten, not carried: %r" % (deferred,)
